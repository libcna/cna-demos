<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: MS-PL
  An XNA Game Studio 4.0 content project, as an XNA developer has one: CNA's content pipeline
  builds it as it is (cna_add_content CONTENT_PROJECT in CMakeLists.txt) into XNB files under
  assets/contentproj. The sources are generated by tools/generate_assets.py; this file and
  credits.txt are written by hand. Demo: content.content_project.xna_content_project.
-->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{3F2B7C1E-6A4D-4E8B-9C2A-1D5E7F9A0B34}</ProjectGuid>
    <XnaFrameworkVersion>v4.0</XnaFrameworkVersion>
    <XnaPlatform>Windows</XnaPlatform>
    <XnaProfile>HiDef</XnaProfile>
    <ContentRootDirectory>Content</ContentRootDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Name renames the asset: the game loads "Textures/ship", not "Textures/ship_source". The
         texture processor keys out magenta by default. -->
    <Compile Include="Textures\ship_source.png">
      <Name>ship</Name>
      <Importer>TextureImporter</Importer>
      <Processor>TextureProcessor</Processor>
    </Compile>
    <!-- A processor parameter set per item, as the Properties window of Visual Studio wrote it. -->
    <Compile Include="Textures\grid.png">
      <Name>grid</Name>
      <Importer>TextureImporter</Importer>
      <Processor>TextureProcessor</Processor>
      <ProcessorParameters_GenerateMipmaps>True</ProcessorParameters_GenerateMipmaps>
    </Compile>
    <Compile Include="Sounds\blip.wav">
      <Name>blip</Name>
      <Importer>WavImporter</Importer>
      <Processor>SoundEffectProcessor</Processor>
    </Compile>
    <!-- Not content to compile: copied beside the built files. -->
    <None Include="credits.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
