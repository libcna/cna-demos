# =============================================================================
# CTest integration for cna-demos.
# =============================================================================
# Two kinds of tests:
#
#  1. Fixed CLI/registry tests (cna_demos.cli.*), registered here.
#
#  2. One test per demo (cna_demos.demo.<renderer>.<demo-id>), discovered when
#     ctest runs -- the same pattern gtest_discover_tests() uses. A small
#     script asks the freshly built executable for `--list-ids` and registers a
#     test per line, so a new demo becomes a new test without re-running CMake.
#     Manual demos are registered DISABLED so they stay visible in reports.
#
# Labels let CI pick a subset:
#   ctest -L cli                 registry/CLI tests only
#   ctest -L headless            everything that needs no display
#   ctest -L display             tests that need a display server (use xvfb-run)
#   ctest -L graphics            one demo category
#   ctest -L automated           demos whose unattended run checks the feature
#   ctest -L smoke-only          demos whose unattended run only proves start/stop
# =============================================================================

include_guard(GLOBAL)

# Renderers the per-demo tests run on. SOFTWARE rasterises for real and needs no
# window, so it is the default whenever it is compiled in.
if("SOFTWARE" IN_LIST CNA_DEMOS_RENDERER_LIST)
    set(_cna_demos_default_test_renderers "SOFTWARE")
else()
    set(_cna_demos_default_test_renderers "${CNA_GRAPHICS_RENDERER}")
endif()
set(CNA_DEMOS_TEST_RENDERERS "${_cna_demos_default_test_renderers}" CACHE STRING
    "Renderers the per-demo CTest tests run on (each must be compiled in)")
set(CNA_DEMOS_TEST_TIMEOUT 120 CACHE STRING "Timeout in seconds of one per-demo test")
set(CNA_DEMOS_TEST_AUDIO_DRIVER "dummy" CACHE STRING
    "SDL_AUDIO_DRIVER for tests: 'dummy' exercises the audio API without hardware; empty = SDL's choice")

foreach(_renderer IN LISTS CNA_DEMOS_TEST_RENDERERS)
    if(NOT _renderer IN_LIST CNA_DEMOS_RENDERER_LIST)
        message(FATAL_ERROR "cna-demos: CNA_DEMOS_TEST_RENDERERS names ${_renderer}, which is not "
                            "compiled in (${CNA_DEMOS_RENDERER_LIST})")
    endif()
endforeach()

# Renderers that open no window and so need no display server.
set(CNA_DEMOS_WINDOWLESS_RENDERERS HEADLESS SOFTWARE STUB)

# --- 1. CLI and registry tests --------------------------------------------------
function(_cna_demos_cli_test name)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "WILL_FAIL" "REGEX" "ARGS")
    add_test(NAME cna_demos.cli.${name} COMMAND cna-demos ${ARG_ARGS})
    set_tests_properties(cna_demos.cli.${name} PROPERTIES LABELS "cli;headless" TIMEOUT 30)
    if(ARG_WILL_FAIL)
        set_tests_properties(cna_demos.cli.${name} PROPERTIES WILL_FAIL TRUE)
    endif()
    if(ARG_REGEX)
        set_tests_properties(cna_demos.cli.${name} PROPERTIES PASS_REGULAR_EXPRESSION "${ARG_REGEX}")
    endif()
endfunction()

_cna_demos_cli_test(help          ARGS --help          REGEX "Usage:")
_cna_demos_cli_test(version       ARGS --version       REGEX "cna-demos [0-9]+\\.[0-9]+\\.[0-9]+ \\(CNA ")
_cna_demos_cli_test(list          ARGS --list          REGEX "math\\.vector2\\.length")
_cna_demos_cli_test(list_prefix   ARGS --list math     REGEX "math\\.vector2\\.length")
_cna_demos_cli_test(categories    ARGS --categories    REGEX "math \\([0-9]+\\)")
_cna_demos_cli_test(search        ARGS --search vector2 REGEX "math\\.vector2\\.length")
_cna_demos_cli_test(info          ARGS --info math.vector2.length REGEX "Vector2::Length")
_cna_demos_cli_test(list_ids      ARGS --list-ids      REGEX "math\\.vector2\\.length console automated - -")
_cna_demos_cli_test(renderers     ARGS --renderers     REGEX "${CNA_GRAPHICS_RENDERER}")
_cna_demos_cli_test(catalog_json  ARGS --catalog-json  REGEX "\"schema\": \"cna-demos-catalog/1\"")
_cna_demos_cli_test(validate      ARGS --validate      REGEX " 0 problem\\(s\\)")
_cna_demos_cli_test(unknown_id    ARGS no.such.demo    WILL_FAIL)
_cna_demos_cli_test(bad_option    ARGS --no-such-option WILL_FAIL)
_cna_demos_cli_test(no_match_tag  ARGS --run-tag no-such-tag WILL_FAIL)

# The catalog must be well-formed JSON. CMake's own JSON parser checks it, so
# this needs no Python.
add_test(NAME cna_demos.cli.catalog_json_parses
    COMMAND "${CMAKE_COMMAND}"
            -DCNA_DEMOS_EXE=$<TARGET_FILE:cna-demos>
            -DCNA_DEMOS_ISSUES_FILE=${CMAKE_SOURCE_DIR}/docs/CNA_ISSUES.md
            -P "${CMAKE_CURRENT_LIST_DIR}/CnaDemosCheckCatalog.cmake")
set_tests_properties(cna_demos.cli.catalog_json_parses PROPERTIES LABELS "cli;headless" TIMEOUT 30)

# --- 2. Per-demo tests, discovered at ctest time ---------------------------------
set(_cna_demos_discovery_script "${CMAKE_CURRENT_BINARY_DIR}/cna_demos_discover_tests.cmake")
file(GENERATE OUTPUT "${_cna_demos_discovery_script}" CONTENT
"# Generated by cmake/CnaDemosTests.cmake -- registers one CTest test per demo.
set(CNA_DEMOS_EXE \"$<TARGET_FILE:cna-demos>\")
set(CNA_DEMOS_TEST_RENDERERS \"${CNA_DEMOS_TEST_RENDERERS}\")
set(CNA_DEMOS_WINDOWLESS_RENDERERS \"${CNA_DEMOS_WINDOWLESS_RENDERERS}\")
set(CNA_DEMOS_TEST_TIMEOUT \"${CNA_DEMOS_TEST_TIMEOUT}\")
set(CNA_DEMOS_TEST_AUDIO_DRIVER \"${CNA_DEMOS_TEST_AUDIO_DRIVER}\")
include(\"${CMAKE_CURRENT_LIST_DIR}/CnaDemosDiscoverTests.cmake\")
")
set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${_cna_demos_discovery_script}")
